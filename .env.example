# Google Gemini API Key for multimodal document and narrative extraction
# Required for live multimodal Gemini calls.
# If not set, Haqdaar runs in high-fidelity deterministic offline/demo mode with 100% functionality.
GEMINI_API_KEY=your_key_here

# Centralized Gemini Model (default: gemini-3.8-flash for fast multimodal reasoning)
GEMINI_MODEL=gemini-3.8-flash

# Server Port (default: 8000 for local dev, 8080 for Cloud Run)
PORT=8000

# Environment Mode: development | production | demo
ENV=development
